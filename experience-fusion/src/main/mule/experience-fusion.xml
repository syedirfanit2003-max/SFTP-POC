<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
      xmlns:jms="http://www.mulesoft.org/schema/mule/jms"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/sftp http://www.mulesoft.org/schema/mule/sftp/current/mule-sftp.xsd
        http://www.mulesoft.org/schema/mule/jms http://www.mulesoft.org/schema/mule/jms/current/mule-jms.xsd">

    <!-- SFTP Config -->
    <sftp:config name="SFTP_Config" >
        <sftp:connection workingDir="/" host="localhost" port="22004" username="fusionuser" password="fusionpass"/>
    </sftp:config>

    <!-- JMS Config -->
    <jms:config name="JMS_Config" >
        <jms:active-mq-connection username="admin" password="admin">
            <jms:factory-configuration brokerUrl="tcp://localhost:61616"/>
        </jms:active-mq-connection>
    </jms:config>

    <!-- Flow -->
    <flow name="SFTP-To-JMS-Flow">
        <sftp:listener 
            config-ref="SFTP_Config" 
            directory="/veeva/inprogress" 
            watermarkEnabled="true" autoDelete="true" applyPostActionWhenFailed="false">
            <scheduling-strategy>
                <fixed-frequency frequency="10000"/>
            </scheduling-strategy>
			<sftp:matcher filenamePattern="*.csv" />
        
</sftp:listener>

        <logger level="INFO" doc:name="Logging filename" doc:id="e5ce62b8-42df-46e2-b4b2-0819e22a788d" message='#["File picked:" ++ attributes.fileName]'/>

        <!-- Publish file content and path to JMS -->
        <jms:publish 
            config-ref="JMS_Config" 
            destination="sftp.queue" doc:name="Publishing the file content">
			<jms:message >
				<jms:body ><![CDATA[#[%dw 2.0
output application/json
---
{
    filePath: attributes.path,
    fileName: attributes.fileName,
    system: "fusion",
    content: payload
}]]]></jms:body>
			</jms:message>
		</jms:publish>
		<logger level="INFO" doc:name="publish success" doc:id="a78341a9-9893-44e9-8716-a4bd9b0465ed" message='#[attributes.fileName ++ "published successfully"]'/>
		<error-handler ref="GlobalErrorFusionError_Handler" />
    
</flow>
</mule>
