		<email:send doc:name="successMessageViaEmail" doc:id="c7965dd3-e2ec-4cd0-bd3b-07070b1a4cca" config-ref="SMTP_Config" fromAddress="syedirfanit2003@gmail.com">
					<email:to-addresses>
						<email:to-address value="syedirfanit20@gmail.com" />
					</email:to-addresses>
					<email:body>
						<email:content><![CDATA[File moved successfully to processed folder.]]></email:content>
					</email:body>
