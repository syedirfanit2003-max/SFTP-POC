		<http:request-connection host="localhost" port="8081" />
	</http:request-config>
	<flow name="Consumer-Flow" doc:id="a0c404a3-382a-4f36-820d-d079eaeb1698">
        <jms:listener config-ref="JMS_Config" destination="sftp.queue" doc:name="picking messages from sftp.queue"/>

        <logger level="INFO" message='#["Received file" ++ payload.fileName]' doc:name="loggingFileName"/>
		<set-variable value="#[payload.system]" doc:name="captureSystemName" doc:id="0ac605b1-c15d-4a04-b5d8-fa6061df3f62" variableName="system"/>
		<http:request method="POST" doc:name="Request to endpoint in system layer" doc:id="6334692f-3205-4665-8764-2826be68b485" config-ref="HTTP_Request_configuration" responseTimeout="500000" path='#["/" ++ vars.system]'>
			
		</http:request>
