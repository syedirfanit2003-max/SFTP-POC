        </jms:active-mq-connection>
    </jms:config>

    <email:smtp-config name="SMTP_Config">
		<email:smtp-connection host="smtp.gmail.com" port="587" user="syedirfanit2003@gmail.com" password="kbwqwxdsnpvczbwh" >
			<email:properties >
				<email:property key="mail.smtp.starttls.enable" value="true" />
			</email:properties>
		</email:smtp-connection>
